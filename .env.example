# TelePlay Backend Configuration Template
# Copy this file to .env and adjust values for your environment.
# Never commit actual .env files containing private tokens or secrets.

# Server settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database (SQLite database path)
DATABASE_PATH=./data/teleplay.db

# Logging (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Cross-Origin Resource Sharing (CORS)
# For production, set to your frontend origin (e.g., https://teleplay.example.com)
CORS_ORIGIN=*

# Channel Health Check Scheduling & Budgets (tuned for Android Termux)
# Minutes between automated background check batches
HEALTH_CHECK_INTERVAL_MINUTES=15
# Number of channels to probe per batch
HEALTH_CHECK_BATCH_SIZE=20
# Maximum global concurrent probe requests (keep low to avoid Termux network saturation)
HEALTH_CHECK_CONCURRENCY=5
# Maximum request timeout in milliseconds for manifest probing
HEALTH_CHECK_TIMEOUT_MS=5000
# Maximum response body bytes to read before aborting (64 KB)
HEALTH_CHECK_MAX_BYTES=65536

